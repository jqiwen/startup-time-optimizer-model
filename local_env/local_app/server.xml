<?xml version="1.0" encoding="UTF-8"?>
<server description="local_app server">

    <featureManager>
        <feature>jsp-2.3</feature>
        <feature>servlet-4.0</feature>
        <feature>monitor-1.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="-1" />

    <webApplication id="local_app"
                    location="local_app.war"
                    contextRoot="/local_app" />
</server>
